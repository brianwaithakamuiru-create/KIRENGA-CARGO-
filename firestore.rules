rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role(r) { return signedIn() && profile().role == r; }
    function staff() { return signedIn() && profile().role in ['admin','operations']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if request.auth.uid == uid || role('admin');
      allow delete: if role('admin');
    }

    match /bookings/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if staff() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if staff() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if role('admin');
    }

    match /shipments/{id} {
      allow read: if staff() || (signedIn() && resource.data.customerId == request.auth.uid) || (signedIn() && resource.data.assignedDriverId == request.auth.uid);
      allow create, update: if staff();
      allow delete: if role('admin');
    }

    match /tracking/{trackingNumber} {
      allow read: if true;
      allow write: if staff();
    }

    match /auditLogs/{id} {
      allow read: if role('admin');
      allow create: if signedIn();
      allow update, delete: if role('admin');
    }
  }
}